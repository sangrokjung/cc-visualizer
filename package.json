{
  "name": "cc-visualizer",
  "version": "1.0.0",
  "description": "Claude Code System Visualizer - 에이전트 맵, 실시간 모니터, 시스템 아키텍처 시각화",
  "main": "./out/main/index.js",
  "scripts": {
