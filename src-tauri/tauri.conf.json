{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "CC Visualizer",
  "version": "1.0.0",
  "identifier": "com.qjc.cc-visualizer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CC Visualizer",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../scripts/scan-system.ts": "scripts/scan-system.ts",
      "../scripts/scan-usage.ts": "scripts/scan-usage.ts",
      "../src/renderer/src/lib/agent-category-map.ts": "src/renderer/src/lib/agent-category-map.ts",
      "../src/renderer/src/data/system-data.json": "data/system-data.json",
      "../src/renderer/src/data/usage-stats.json": "data/usage-stats.json",
      "../src/renderer/src/data/external-systems.json": "data/external-systems.json"
    }
  }
}
